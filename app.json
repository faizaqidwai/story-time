{
  "expo": {
    "scheme": "storytimeapp",
    "name": "Story Time",
    "slug": "StoryTime_APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/story-time-logo-4.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc042d77-0c1f-48a2-833e-7f0b8c1a88f4"
    },
    "splash": {
      "image": "./assets/img/story-time-logo-4.png",
      "resizeMode": "contain",
      "backgroundColor": "#08081a"
    },
    "ios": {
      "bundleIdentifier": "com.codeklusters.storytime",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/story-time-logo-4.png",
        "backgroundColor": "#08081a"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "dc042d77-0c1f-48a2-833e-7f0b8c1a88f4"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-av"
    ],
    "owner": "faiza.qidwai"
  }
}
