{
  "expo": {
    "scheme": "storytimeapp",
    "name": "Story Time",
    "slug": "StoryTime_APP",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/img/storytime-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc042d77-0c1f-48a2-833e-7f0b8c1a88f4"
    },
    "ios": {
      "bundleIdentifier": "com.codeklusters.storytime",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/story-time-logo-4.png",
        "backgroundColor": "#08081a"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.codeklusters.storytime"
    },
    "extra": {
      "eas": {
        "projectId": "dc042d77-0c1f-48a2-833e-7f0b8c1a88f4"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-av"],
    "owner": "faiza.qidwai"
  }
}
